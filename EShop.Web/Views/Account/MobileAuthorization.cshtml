@model EShop.Data.DTOs.Account.MobileActivationDTO
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "تایید شماره موبایل";
    Layout = "_SiteLayout";
}

<div class="account-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7">
                <div class="card shadow-sm">
                    <div class="card-body p-4 p-md-5">

                        <div class="text-center mb-4">
                            <div style="font-size:55px; filter:drop-shadow(0 5px 10px rgba(0,0,0,0.1));">🕯️</div>
                            <h2 class="fw-bold mt-3">@ViewData["Title"]</h2>
                            <p class="text-muted mb-1">کد ارسال شده به شماره موبایل را وارد کنید.</p>
                            <small class="text-secondary fw-bold">@Model?.Mobile</small>
                        </div>

                        <form asp-controller="Account"
                              asp-action="MobileAuthorization"
                              method="post"
                              id="otpForm">

                            @Html.AntiForgeryToken()

                            <input asp-for="Mobile" type="hidden" />
                            <input asp-for="ReturnUrl" type="hidden" />
                            <input asp-for="Token" type="hidden" id="captchaInput" />
                            <input type="hidden" asp-for="ActivationCode" id="hiddenActivationCode" />

                            <div class="otp-inputs">
                                <input type="number" class="otp-field" maxlength="1" inputmode="numeric">
                                <input type="number" class="otp-field" maxlength="1" inputmode="numeric">
                                <input type="number" class="otp-field" maxlength="1" inputmode="numeric">
                                <input type="number" class="otp-field" maxlength="1" inputmode="numeric">
                                <input type="number" class="otp-field" maxlength="1" inputmode="numeric">
                            </div>

                            <div class="text-center mb-3">
                                <span asp-validation-for="ActivationCode" class="text-danger small"></span>
                            </div>

                            <div class="timer-wrap text-center mb-3">
                                <div id="otpTimer"></div>

                                <a asp-controller="Account"
                                   asp-action="ResendVerificationCode"
                                   asp-route-mobileNumber="@Model?.Mobile"
                                   asp-route-returnUrl="@Model?.ReturnUrl"
                                   id="resendCode"
                                   style="display:none;">
                                    ارسال مجدد کد
                                </a>
                            </div>

                            <button type="submit"
                                    class="btn btn-dark w-100 py-3 fw-bold shadow-sm"
                                    style="border-radius:12px;">
                                تایید و ورود
                            </button>

                        </form>

                        <div class="text-center mt-4">
                            <a asp-controller="Account"
                               asp-action="RegisterOrLogin"
                               class="text-decoration-none small text-muted">
                                <i class="fa fa-edit me-1"></i>
                                تغییر شماره موبایل
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section _SiteFooterSection
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        window.onload = function () {
            startOtpTimer();
            setupOtpLogic();
        };

        function setupOtpLogic() {
            const inputs = document.querySelectorAll('.otp-field');
            const hiddenInput = document.getElementById('hiddenActivationCode');

            inputs.forEach((input, index) => {

                input.addEventListener('input', (e) => {
                    if (e.target.value.length > 1) {
                        e.target.value = e.target.value.slice(0, 1);
                    }

                    if (e.target.value && index < inputs.length - 1) {
                        inputs[index + 1].focus();
                    }

                    updateHiddenValue();
                });

                input.addEventListener('keydown', (e) => {
                    if (e.key === 'Backspace' && !input.value && index > 0) {
                        inputs[index - 1].focus();
                    }
                });

                input.addEventListener('paste', (e) => {
                    const data = e.clipboardData.getData('text').trim();

                    if (data.length === inputs.length) {
                        for (let i = 0; i < inputs.length; i++) {
                            inputs[i].value = data[i];
                        }

                        updateHiddenValue();
                        inputs[inputs.length - 1].focus();
                    }

                    e.preventDefault();
                });
            });

            function updateHiddenValue() {
                let fullCode = "";

                inputs.forEach(input => {
                    fullCode += input.value;
                });

                hiddenInput.value = fullCode;
            }
        }
    </script>

    <script src="https://www.google.com/recaptcha/api.js?render=@Configuration["googleReCaptcha:SiteKey"]"></script>

    <script>
        grecaptcha.ready(function () {
        grecaptcha.execute(
        '@Configuration["googleReCaptcha:SiteKey"]',
        { action: 'register_or_login' }
        ).then(function (token) {
        document.getElementById("captchaInput").value = token;
        });
        });
    </script>
}