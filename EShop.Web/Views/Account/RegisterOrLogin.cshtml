@model EShop.Data.DTOs.Account.RegisterUserDTO

@{
    ViewData["Title"] = "ورود / ثبت نام";
    Layout = "_SiteLayout";
}

<div class="account-page">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-5 col-md-8">

                <div class="card shadow">

                    <div class="card-body">

                        <div class="text-center mb-4">

                            <div style="font-size:55px;">
                                🕯️
                            </div>

                            <h2 class="fw-bold mt-2">
                                Lumi Candle
                            </h2>

                            <p class="text-muted mb-0">
                                ورود / ثبت نام
                            </p>

                            <small class="text-muted">
                                برای ادامه خرید شماره موبایل خود را وارد کنید
                            </small>

                        </div>

                        <form asp-controller="Account"
                              asp-action="RegisterOrLogin"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input asp-for="ReturnUrl" type="hidden" />

                            <div class="mb-3">

                                <label asp-for="MobileNumber" class="form-label">
                                    شماره موبایل
                                </label>

                                <input asp-for="MobileNumber"
                                       class="form-control"
                                       placeholder="09xxxxxxxxx" />

                                <span asp-validation-for="MobileNumber" class="text-danger"></span>

                            </div>

                            <button type="submit" class="btn btn-dark w-100">
                                ادامه
                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section _SiteFooterSection
{
    <partial name="_ValidationScriptsPartial" />
}